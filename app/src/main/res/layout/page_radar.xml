<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.boyoffi9.scifikit.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="20dp"
        app:sfAccentColor="#B388FF"
        app:sfSweep="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DECODE MODE"
                android:textColor="?attr/sfThemeDim"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/decodePicker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:popupBackground="#0B1218" />

            <com.boyoffi9.scifikit.GlitchTextView
                android:id="@+id/decodeSample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ACCESS GRANTED // NODE 7F"
                android:textSize="20sp"
                app:sfDecodeMode="classic"
                app:sfGlitchMode="onTouch" />
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

    <com.boyoffi9.scifikit.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="20dp"
        app:sfAccentColor="#FFC400"
        app:sfSweep="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GLITCH MODE"
                android:textColor="?attr/sfThemeDim"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/glitchPicker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:popupBackground="#0B1218" />

            <com.boyoffi9.scifikit.GlitchTextView
                android:id="@+id/glitchSample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="INTRUSION DETECTED"
                android:textSize="22sp"
                app:sfGlitchMode="standard" />
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

    <com.boyoffi9.scifikit.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:sfAccentColor="#7CFFB2"
        app:sfSweep="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOUCH MODE"
                android:textColor="?attr/sfThemeDim"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/touchPicker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:popupBackground="#0B1218" />

            <com.boyoffi9.scifikit.GlitchTextView
                android:id="@+id/touchSample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PRESS AND DRAG HERE"
                android:textSize="26sp"
                app:sfGlitchMode="onTouch"
                app:sfTouchMode="burst" />
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

    <TextView
        android:id="@+id/replayDecode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="REPLAY DECODE >"
        android:textColor="?attr/sfThemeText"
        android:textSize="18sp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Text.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="HOLO RADAR"
        android:textColor="?attr/sfThemeDim" />

    <com.boyoffi9.scifikit.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:sfAccentColor="#00E5FF"
        app:sfSweep="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <Spinner
                android:id="@+id/radarPicker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#0B1218" />

            <com.boyoffi9.scifikit.HoloRadarView
                android:id="@+id/radarSample"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Modes change blip shape, trail, grid and glow."
                android:textColor="?attr/sfThemeDim"
                android:textSize="13sp" />
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

    <com.boyoffi9.scifikit.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        app:sfAccentColor="#B388FF"
        app:sfSweep="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLIP SHAPES"
                android:textColor="?attr/sfThemeDim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.boyoffi9.scifikit.HoloRadarView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    app:sfBlipCount="2"
                    app:sfRadarMode="classic" />

                <com.boyoffi9.scifikit.HoloRadarView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    app:sfBlipCount="2"
                    app:sfRadarMode="tactical" />

                <com.boyoffi9.scifikit.HoloRadarView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    app:sfBlipCount="2"
                    app:sfRadarMode="cyberpunk" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Dot / Diamond / Square — sfRadarMode per blip shape."
                android:textColor="?attr/sfThemeDim"
                android:textSize="12sp" />
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

</LinearLayout>

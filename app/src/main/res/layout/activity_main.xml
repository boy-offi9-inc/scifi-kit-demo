<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.boyoffi9.scifikit.GlitchTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCIFIKIT // VIEWS"
            android:textColor="@color/sf_text"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Tap any glitch text to glitch it."
            android:textColor="@color/sf_dim"
            android:textSize="13sp" />

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#00E5FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ONLINE"
                    android:textColor="@color/sf_text"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All subsystems nominal."
                    android:textColor="@color/sf_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#FF2D6F"
            app:sfChamfer="22dp">

            <com.boyoffi9.scifikit.GlitchTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTRUSION DETECTED"
                android:textColor="@color/sf_text"
                android:textSize="22sp"
                app:sfDecodeDurationMs="1400"
                app:sfGlitchIntervalMs="1800"
                app:sfIntensity="1.6"
                app:sfSplitColorA="#00E5FF"
                app:sfSplitColorB="#FFC400" />
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:id="@+id/liveFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.boyoffi9.scifikit.GlitchTextView
                    android:id="@+id/liveText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE // CLASSIC"
                    android:textColor="@color/sf_text"
                    android:textSize="18sp" />

                <com.boyoffi9.scifikit.HoloRadarView
                    android:id="@+id/liveRadar"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tap the panel to reconfigure everything live."
                    android:textColor="@color/sf_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#B388FF"
            app:sfSweep="false">

            <LinearLayout
                android:id="@+id/decodeModes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="CLASSIC // THE ORIGINAL"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfDecodeMode="classic" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="RELAXED // SLOW AND CALM"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfDecodeMode="relaxed" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="ACTIVE // NEVER SETTLES"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfDecodeMode="active" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="RANDOM // ANY ORDER"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfDecodeMode="random" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="CENTER OUT // FROM MIDDLE"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfDecodeMode="centerOut" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TYPEWRITER // CURSOR"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfDecodeMode="typewriter" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#FF2D6F"
            app:sfSweep="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="SUBTLE // BARELY THERE"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfGlitchMode="subtle" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="STANDARD // THE ORIGINAL"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfGlitchMode="standard" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="VIOLENT // FULL TEAR"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfGlitchMode="violent" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGNAL LOSS // DROPS OUT"
                    android:textColor="@color/sf_text"
                    android:textSize="16sp"
                    app:sfGlitchMode="signalLoss" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#7CFFB2"
            app:sfSweep="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="BURST // TAP"
                    android:textColor="@color/sf_text"
                    android:textSize="22sp"
                    app:sfTouchMode="burst" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="FOLLOW // DRAG ON ME"
                    android:textColor="@color/sf_text"
                    android:textSize="22sp"
                    app:sfTouchMode="follow" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="CHARGE // HOLD ME"
                    android:textColor="@color/sf_text"
                    android:textSize="22sp"
                    app:sfTouchMode="charge" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOLLOW + CHARGE // BOTH"
                    android:textColor="@color/sf_text"
                    android:textSize="22sp"
                    app:sfTouchMode="followCharge" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#00E5FF"
            app:sfSweep="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.boyoffi9.scifikit.HoloRadarView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        app:sfAccentColor="#7CFFB2"
                        app:sfRadarMode="tactical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TACTICAL"
                        android:textColor="@color/sf_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.boyoffi9.scifikit.HoloRadarView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        app:sfAccentColor="#00E5FF"
                        app:sfRadarMode="cyberpunk" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CYBERPUNK"
                        android:textColor="@color/sf_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.boyoffi9.scifikit.HoloRadarView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        app:sfAccentColor="#7CFFB2"
                        app:sfRadarMode="phosphor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHOSPHOR"
                        android:textColor="@color/sf_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.boyoffi9.scifikit.HoloRadarView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        app:sfAccentColor="#00E5FF"
                        app:sfRadarMode="hologram" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOLOGRAM"
                        android:textColor="@color/sf_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:id="@+id/replayDecode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            app:sfAccentColor="#FFC400"
            app:sfSweep="false">

            <com.boyoffi9.scifikit.GlitchTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPLAY DECODE >"
                android:textColor="@color/sf_text"
                android:textSize="18sp" />
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#7CFFB2"
            app:sfSweep="false">

            <com.boyoffi9.scifikit.HoloRadarView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:sfAccentColor="#7CFFB2"
                app:sfBlipCount="8" />
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:id="@+id/openCompose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            app:sfAccentColor="#FFC400"
            app:sfSweep="false">

            <com.boyoffi9.scifikit.GlitchTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN COMPOSE DEMO >"
                android:textColor="@color/sf_text"
                android:textSize="18sp" />
        </com.boyoffi9.scifikit.HudFrameView>

    </LinearLayout>
</ScrollView>

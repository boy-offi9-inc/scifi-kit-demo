<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.boyoffi9.scifikit.GlitchTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCIFIKIT // VIEWS"
            android:textColor="@color/sf_text"
            android:textSize="30sp"
                app:sfGlitchMode="onTouch" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Tap any glitch text to glitch it."
            android:textColor="@color/sf_dim"
            android:textSize="13sp" />

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#00E5FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.boyoffi9.scifikit.GlitchTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ONLINE"
                    android:textColor="@color/sf_text"
                    android:textSize="22sp"
                app:sfGlitchMode="onTouch" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All subsystems nominal."
                    android:textColor="@color/sf_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#FF2D6F"
            app:sfChamfer="22dp">

            <com.boyoffi9.scifikit.GlitchTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTRUSION DETECTED"
                android:textColor="@color/sf_text"
                android:textSize="22sp"
                app:sfDecodeDurationMs="1400"
                app:sfIntensity="1.6"
                app:sfSplitColorA="#00E5FF"
                app:sfSplitColorB="#FFC400"
                app:sfGlitchMode="onTouch" />
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:id="@+id/liveFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.boyoffi9.scifikit.GlitchTextView
                    android:id="@+id/liveText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE // CLASSIC"
                    android:textColor="@color/sf_text"
                    android:textSize="18sp"
                app:sfGlitchMode="onTouch" />

                <com.boyoffi9.scifikit.HoloRadarView
                    android:id="@+id/liveRadar"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tap the panel to reconfigure everything live."
                    android:textColor="@color/sf_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#B388FF"
            app:sfSweep="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/decodePicker"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:popupBackground="#0B1218" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:id="@+id/decodeSample"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ACCESS GRANTED // NODE 7F"
                    android:textColor="@color/sf_text"
                    android:textSize="20sp"
                app:sfGlitchMode="onTouch" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#FF2D6F"
            app:sfSweep="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/glitchPicker"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:popupBackground="#0B1218" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:id="@+id/glitchSample"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="INTRUSION DETECTED"
                    android:textColor="@color/sf_text"
                    android:textSize="22sp" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#7CFFB2"
            app:sfSweep="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/touchPicker"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:popupBackground="#0B1218" />

                <com.boyoffi9.scifikit.GlitchTextView
                    android:id="@+id/touchSample"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="PRESS AND DRAG HERE"
                    android:textColor="@color/sf_text"
                    android:textSize="26sp"
                app:sfGlitchMode="onTouch" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#00E5FF"
            app:sfSweep="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/radarPicker"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:popupBackground="#0B1218" />

                <com.boyoffi9.scifikit.HoloRadarView
                    android:id="@+id/radarSample"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    app:sfAccentColor="#00E5FF" />
            </LinearLayout>
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:id="@+id/replayDecode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            app:sfAccentColor="#FFC400"
            app:sfSweep="false">

            <com.boyoffi9.scifikit.GlitchTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPLAY DECODE >"
                android:textColor="@color/sf_text"
                android:textSize="18sp"
                app:sfGlitchMode="onTouch" />
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="20dp"
            app:sfAccentColor="#7CFFB2"
            app:sfSweep="false">

            <com.boyoffi9.scifikit.HoloRadarView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:sfAccentColor="#7CFFB2"
                app:sfBlipCount="8" />
        </com.boyoffi9.scifikit.HudFrameView>

        <com.boyoffi9.scifikit.HudFrameView
            android:id="@+id/openCompose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            app:sfAccentColor="#FFC400"
            app:sfSweep="false">

            <com.boyoffi9.scifikit.GlitchTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN COMPOSE DEMO >"
                android:textColor="@color/sf_text"
                android:textSize="18sp"
                app:sfGlitchMode="onTouch" />
        </com.boyoffi9.scifikit.HudFrameView>

    </LinearLayout>
</ScrollView>

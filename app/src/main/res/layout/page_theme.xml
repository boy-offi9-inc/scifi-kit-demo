<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.boyoffi9.scifikit.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:sfAccentColor="#00E5FF"
        app:sfSweep="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RADAR MODE"
                android:textColor="?attr/sfThemeDim"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/radarPicker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:popupBackground="#0B1218" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center">

                <com.boyoffi9.scifikit.HoloRadarView
                    android:id="@+id/radarSample"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    app:sfAccentColor="#00E5FF"
                    app:sfRadarMode="classic" />
            </FrameLayout>
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

</LinearLayout>

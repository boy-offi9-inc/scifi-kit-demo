<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Text.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="STATUS CONSOLE"
        android:textColor="?attr/sfThemeDim" />

    <com.boyoffi9.scifikit.HudFrameView
        android:id="@+id/liveFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.boyoffi9.scifikit.GlitchTextView
                android:id="@+id/liveText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE // CLASSIC"
                android:textSize="20sp"
                app:sfGlitchMode="onTouch" />

            <com.boyoffi9.scifikit.HoloRadarView
                android:id="@+id/liveRadar"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="TAP PANEL TO RECONFIGURE //"
                android:textColor="?attr/sfThemeDim"
                android:textSize="12sp" />
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

    <TextView
        style="@style/Text.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="BOOT LOG"
        android:textColor="?attr/sfThemeDim" />

    <com.boyoffi9.scifikit.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:sfAccentColor="#7CFFB2"
        app:sfSweep="false">

        <TextView
            android:id="@+id/bootLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="?attr/sfThemeDim"
            android:textSize="12sp" />
    </com.boyoffi9.scifikit.HudFrameView>

</LinearLayout>

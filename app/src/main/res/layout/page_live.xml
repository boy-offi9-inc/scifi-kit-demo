<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.boyoffi9.scifikit.HudFrameView
        android:id="@+id/liveFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:sfSweep="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.boyoffi9.scifikit.GlitchTextView
                android:id="@+id/liveText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE // CLASSIC"
                android:textSize="18sp"
                app:sfGlitchMode="onTouch" />

            <com.boyoffi9.scifikit.HoloRadarView
                android:id="@+id/liveRadar"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="12dp"
                app:sfAccentColor="#00E5FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tap the panel to reconfigure everything live."
                android:textColor="?attr/sfThemeDim"
                android:textSize="13sp" />
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

</LinearLayout>

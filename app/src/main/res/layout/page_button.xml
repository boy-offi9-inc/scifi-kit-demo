<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.boyoffi9.scifikit.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="20dp"
        app:sfAccentColor="#00E5FF"
        app:sfSweep="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Spinner
                android:id="@+id/neonPicker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#0B1218" />

            <com.boyoffi9.scifikit.NeonButtonView
                android:id="@+id/neonSample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ENGAGE" />

            <com.boyoffi9.scifikit.NeonButtonView
                android:id="@+id/neonDisabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="LOCKED" />

            <TextView
                android:id="@+id/neonCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="TAPS: 0"
                android:textColor="?attr/sfThemeDim"
                android:textSize="13sp" />
        </LinearLayout>
    </com.boyoffi9.scifikit.HudFrameView>

</LinearLayout>

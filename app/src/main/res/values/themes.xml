        <item name="android:statusBarColor">?attr/sfThemeBackground</item>
        <item name="android:navigationBarColor">?attr/sfThemeBackground</item>
        <item name="sfThemeBackground">@color/sf_bg</item>
    </style>

    <style name="ThemeOverlay.SciFi.Amber" parent="">
